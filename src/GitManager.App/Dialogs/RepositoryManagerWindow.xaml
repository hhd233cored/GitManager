<Window x:Class="GitManager.App.Dialogs.RepositoryManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="管理仓库列表" Width="780" Height="590" MinWidth="660" MinHeight="480"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <DockPanel Margin="23,22,23,17">
            <Button DockPanel.Dock="Right" Content="＋ 添加仓库…" Click="Add_Click" Style="{StaticResource PrimaryButton}" Padding="14,8" VerticalAlignment="Center" IsEnabled="{Binding CanManageRepositories}" />
            <StackPanel>
                <TextBlock Text="管理仓库列表" FontSize="23" FontWeight="SemiBold" />
                <TextBlock Text="{Binding Repositories.Count, StringFormat={}已保存 {0} 个本地仓库}" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,7,0,0" />
            </StackPanel>
        </DockPanel>
        <Grid Grid.Row="1" Margin="23,0,23,13">
            <TextBox x:Name="SearchBox" TextChanged="Search_TextChanged" Padding="10,7" ToolTip="按显示名称或本地路径过滤仓库" />
            <TextBlock x:Name="SearchPlaceholder" Text="按名称或路径查找仓库…" Foreground="#87939F" Margin="11,0,0,0" IsHitTestVisible="False" />
        </Grid>
        <Border Grid.Row="2" Margin="23,0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="5" ClipToBounds="True">
            <Grid>
                <ListBox x:Name="RepositoryList" SelectionChanged="RepositoryList_SelectionChanged" MouseDoubleClick="RepositoryList_DoubleClick" AutomationProperties.Name="已保存的仓库列表">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="#EDF0F3" BorderThickness="0,0,0,1" Padding="14,12">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="27" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <Path Data="M 1,1 L 14,1 L 14,17 L 1,17 Z M 4,1 L 4,17" Stroke="#72849B" StrokeThickness="1.2" Width="15" Height="18" VerticalAlignment="Center" Stretch="Uniform" HorizontalAlignment="Left" />
                                    <StackPanel Grid.Column="1" ToolTip="{Binding Path}">
                                        <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Path}" Foreground="{StaticResource MutedBrush}" FontSize="10.5" Margin="0,5,0,0" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock x:Name="EmptyMessage" Text="列表为空，可添加本地 Git 仓库。" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" />
            </Grid>
        </Border>
        <DockPanel Grid.Row="3" Margin="23,12,23,13">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button x:Name="MoveUpButton" Content="↑" Padding="11,5" Click="MoveUp_Click" ToolTip="上移（清空搜索后可排序）" Margin="0,0,6,0" />
                <Button x:Name="MoveDownButton" Content="↓" Padding="11,5" Click="MoveDown_Click" ToolTip="下移（清空搜索后可排序）" />
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <Button x:Name="RenameButton" Content="重命名…" Click="Rename_Click" Padding="11,5" Margin="0,0,7,0" ToolTip="修改本程序中的显示名称" />
                <Button x:Name="RelocateButton" Content="更改位置…" Click="Relocate_Click" Padding="11,5" Margin="0,0,7,0" ToolTip="重新关联仓库的本地文件夹" />
                <Button x:Name="RemoveButton" Content="移除" Click="Remove_Click" Padding="11,5" Foreground="{StaticResource RedBrush}" />
            </StackPanel>
        </DockPanel>
        <Border Grid.Row="4" Background="#FFF4E5" BorderBrush="#EDC986" BorderThickness="0,1,0,1" Padding="23,9" Visibility="{Binding HasError, Converter={StaticResource BoolVisibility}}">
            <TextBox Text="{Binding Error, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0" Background="Transparent" Foreground="#7D4E00" MaxHeight="75" VerticalScrollBarVisibility="Auto" Padding="0" />
        </Border>
        <Border Grid.Row="5" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="23,15">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="12,0,0,0">
                    <Button Content="完成" IsCancel="True" Click="Close_Click" Padding="14,7" Margin="0,0,8,0" />
                    <Button x:Name="OpenButton" Content="切换到此仓库" Click="Open_Click" Style="{StaticResource PrimaryButton}" Padding="14,7" />
                </StackPanel>
                <TextBlock Text="名称与排序会自动保存。&#10;移除列表记录会保留本地文件。" Foreground="{StaticResource MutedBrush}" FontSize="10.5" LineHeight="18" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
