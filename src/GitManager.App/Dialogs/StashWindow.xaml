<Window x:Class="GitManager.App.Dialogs.StashWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:GitManager.App.Controls"
        Title="Stash" Width="520" Height="650" MinWidth="430" MinHeight="450" ShowInTaskbar="False">
    <Border Background="White" Padding="14"><Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="1.2*" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,10"><Button DockPanel.Dock="Right" Content="保存当前改动…" Click="Save_Click" IsEnabled="{Binding CanStartOperation}" /><TextBlock Text="Stash" FontSize="20" FontWeight="SemiBold" /></DockPanel>
        <TextBlock Grid.Row="1" Text="{Binding Error}" Foreground="#C04444" TextWrapping="Wrap" Margin="0,0,0,8" Visibility="{Binding HasError, Converter={StaticResource BoolVisibility}}" />
        <ListBox x:Name="StashesList" Grid.Row="2" ItemsSource="{Binding Stashes}" SelectionChanged="Selection_Changed" BorderThickness="1" BorderBrush="{StaticResource BorderBrush}">
            <ListBox.ItemTemplate><DataTemplate><StackPanel Margin="9,7"><TextBlock Text="{Binding Message}" TextWrapping="Wrap" /><TextBlock FontSize="10" Foreground="{StaticResource MutedBrush}"><Run Text="{Binding Selector, Mode=OneWay}" /><Run Text="  " /><Run Text="{Binding Date.LocalDateTime, StringFormat={}{0:yyyy-MM-dd HH:mm}, Mode=OneWay}" /></TextBlock></StackPanel></DataTemplate></ListBox.ItemTemplate>
        </ListBox>
        <DockPanel Grid.Row="3" Margin="0,9"><Button DockPanel.Dock="Right" Content="查看文件与 Diff" Click="View_Click" Padding="7,3" /><TextBlock Text="选中文件后，在主窗口右侧查看 Diff" FontSize="10.5" Foreground="{StaticResource MutedBrush}" /></DockPanel>
        <ListBox Grid.Row="4" x:Name="StashFilesList" ItemsSource="{Binding Files}" SelectedItem="{Binding SelectedFile, Mode=TwoWay}" BorderThickness="1" BorderBrush="{StaticResource BorderBrush}" Visibility="{Binding IsStash, Converter={StaticResource BoolVisibility}}">
            <ListBox.ItemTemplate><DataTemplate><Grid Height="28" Margin="8,0" ToolTip="{Binding DisplayPath}"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="20" /></Grid.ColumnDefinitions><TextBlock Text="{Binding Path}" TextTrimming="CharacterEllipsis" /><controls:FileStatusIcon Grid.Column="1" Status="{Binding Status}" Width="13" Height="13" VerticalAlignment="Center" HorizontalAlignment="Right" /></Grid></DataTemplate></ListBox.ItemTemplate>
        </ListBox>
        <StackPanel Grid.Row="5" Margin="0,12,0,0">
            <CheckBox x:Name="RestoreIndexCheckBox" Content="同时恢复暂存状态" IsChecked="True" Margin="0,0,0,10" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" IsEnabled="{Binding CanStartOperation}">
                <Button Content="应用并保留" Click="Apply_Click" Margin="0,0,7,0" /><Button Content="应用并删除" Click="Pop_Click" Margin="0,0,7,0" /><Button Content="删除…" Click="Drop_Click" />
            </StackPanel>
        </StackPanel>
    </Grid></Border>
</Window>
