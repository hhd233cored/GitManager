<UserControl x:Class="GitManager.App.Controls.AssistantPane"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:GitManager.App.Controls"
             PreviewKeyDown="Pane_PreviewKeyDown">
    <Border Background="#FAFBFC" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,0,0,0">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <StackPanel Margin="12,10,12,8">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Content="设置" Command="{Binding SettingsCommand}" FontSize="10.5" Padding="6,2" Margin="0,0,5,0" />
                        <Button Content="×" Command="{Binding CloseCommand}" Padding="5,0" ToolTip="收起助手" />
                    </StackPanel>
                    <Button x:Name="AssistantHistoryButton" Content="{Binding ConversationTitle}" FontWeight="SemiBold" FontSize="13"
                            HorizontalAlignment="Left" VerticalAlignment="Center" Padding="0" Margin="0,0,8,0" Cursor="Hand"
                            Background="Transparent" BorderThickness="0" Click="ConversationTitle_Click"
                            MouseEnter="ConversationTitle_MouseEnter" MouseLeave="ConversationMenu_MouseLeave">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                                    <TextBlock Text="{TemplateBinding Content}" FontSize="{TemplateBinding FontSize}"
                                               FontWeight="{TemplateBinding FontWeight}" TextTrimming="CharacterEllipsis" />
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </DockPanel>
            </StackPanel>
            <ScrollViewer x:Name="ConversationScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="12,0,12,10">
                <StackPanel>
                    <ItemsControl x:Name="ConversationMessages" ItemsSource="{Binding DisplayedMessages, NotifyOnTargetUpdated=True}" TargetUpdated="ConversationMessages_TargetUpdated">
                        <ItemsControl.ItemTemplate><DataTemplate>
                            <StackPanel Margin="0,7,0,12">
                                <TextBlock Text="{Binding Label}" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,5" />
                                <Expander Header="读取与检索记录" FontSize="10" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,5">
                                    <Expander.Style><Style TargetType="Expander"><Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers><DataTrigger Binding="{Binding ToolSteps.Count}" Value="0"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers>
                                    </Style></Expander.Style>
                                    <ItemsControl ItemsSource="{Binding ToolSteps}"><ItemsControl.ItemTemplate><DataTemplate>
                                        <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,3" />
                                    </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                                </Expander>
                                <controls:MarkdownView Markdown="{Binding Text}" FontSize="11.5" SourceRequested="Source_Requested"
                                                       AllowSourceLinks="{Binding DataContext.IsLiveConversation, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                            </StackPanel>
                        </DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <StackPanel Visibility="{Binding IsLiveConversation, Converter={StaticResource BoolVisibility}}">
                    <Border x:Name="CommitDraftCard" Background="White" BorderBrush="#C7DDF5" BorderThickness="1" CornerRadius="5" Padding="10" Margin="0,7,0,10" Visibility="{Binding HasDraft, Converter={StaticResource BoolVisibility}}">
                        <StackPanel>
                            <TextBlock Text="提交草稿" FontWeight="SemiBold" Margin="0,0,0,7" />
                            <TextBlock Text="{Binding Draft.Summary}" TextWrapping="Wrap" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding Draft.Description}" TextWrapping="Wrap" FontSize="11" Margin="0,7,0,9" Foreground="{StaticResource MutedBrush}" />
                            <TextBlock Text="{Binding Draft.Warning}" TextWrapping="Wrap" FontSize="10.5" Foreground="#9A6700" Margin="0,0,0,7" Visibility="{Binding Draft.Warning, Converter={StaticResource StringVisibility}}" />
                            <Button Content="填入提交区" Command="{Binding ApplyDraftCommand}" HorizontalAlignment="Left" Style="{StaticResource PrimaryButton}" Padding="10,4" />
                        </StackPanel>
                    </Border>
                    <ItemsControl ItemsSource="{Binding Plans}">
                        <ItemsControl.ItemTemplate><DataTemplate>
                            <Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="5" Padding="10" Margin="0,6,0,5">
                                <StackPanel>
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding Status}" Foreground="{StaticResource BlueBrush}" FontSize="10.5" Margin="0,5,0,4" />
                                    <TextBlock Text="{Binding Detail}" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" FontSize="10.5" MaxHeight="90" TextTrimming="CharacterEllipsis" />
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0" Visibility="{Binding CanReview, Converter={StaticResource BoolVisibility}}">
                                        <Button Content="查看预览…" Click="ReviewPlan_Click" Padding="9,3" Margin="0,0,6,0" />
                                        <Button Content="取消计划" Click="DeclinePlan_Click" Padding="7,3" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
            <StackPanel Grid.Row="2" Margin="12,5,12,10">
                <TextBlock Text="{Binding Error}" TextWrapping="Wrap" Foreground="{StaticResource RedBrush}" FontSize="10.5" MaxHeight="90" Margin="0,0,0,5" />
                <TextBox x:Name="AssistantInput" Text="{Binding Input, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="58" MaxHeight="120" VerticalScrollBarVisibility="Auto" PreviewKeyDown="Input_KeyDown" ToolTip="描述你的 Git 问题，Ctrl+Enter 发送"
                         Visibility="{Binding IsLiveConversation, Converter={StaticResource BoolVisibility}}" />
                <DockPanel Margin="0,8,0,5">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Visibility="{Binding IsLiveConversation, Converter={StaticResource BoolVisibility}}">
                        <Button Content="停止" Command="{Binding CancelCommand}" Padding="9,4" Margin="0,0,5,0" Visibility="{Binding IsBusy, Converter={StaticResource BoolVisibility}}" />
                        <Button x:Name="SendAssistantButton" Content="发送" Command="{Binding SendCommand}" Padding="12,4" Style="{StaticResource PrimaryButton}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="新建对话" Command="{Binding NewConversationCommand}" Padding="0,3" FontSize="10" Background="Transparent" BorderThickness="0" />
                        <Button Content="返回当前对话" Command="{Binding ReturnToConversationCommand}" Padding="0,3" FontSize="10" Background="Transparent" BorderThickness="0" Margin="12,0,0,0"
                                Visibility="{Binding IsViewingHistory, Converter={StaticResource BoolVisibility}}" />
                    </StackPanel>
                </DockPanel>
                <TextBlock Text="{Binding McpStatus}" Foreground="#87939F" FontSize="9.5" TextTrimming="CharacterEllipsis" ToolTip="{Binding McpStatus}" />
            </StackPanel>
            <Border x:Name="ConversationMenu" Grid.Row="1" Grid.RowSpan="2" Panel.ZIndex="1" VerticalAlignment="Top" Margin="12,0,12,0"
                    Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="5" Visibility="Collapsed"
                    MouseEnter="ConversationMenu_MouseEnter" MouseLeave="ConversationMenu_MouseLeave">
                <DockPanel>
                    <TextBlock x:Name="ConversationMenuStatus" DockPanel.Dock="Top" Margin="10,8" FontSize="11" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" />
                    <ListBox x:Name="ConversationList" MaxHeight="290" Padding="3" Margin="0,2" AutomationProperties.Name="历史会话列表"
                             IsEnabled="{Binding IsBusy, Converter={StaticResource Not}}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <DockPanel LastChildFill="True" Margin="0,1" ToolTip="{Binding RepositoryPath}">
                                    <Button DockPanel.Dock="Right" Content="×" ToolTip="删除会话" AutomationProperties.Name="删除会话" Click="DeleteConversation_Click"
                                            VerticalAlignment="Center" Padding="6,3" Margin="2,0,3,0" Background="Transparent" BorderThickness="0" />
                                    <Button DockPanel.Dock="Right" Content="备份" ToolTip="备份到账号" AutomationProperties.Name="备份到账号" Click="BackupConversation_Click"
                                            VerticalAlignment="Center" Padding="6,3" Margin="2,0,0,0" Background="Transparent" BorderThickness="0" FontSize="10.5" />
                                    <Button HorizontalContentAlignment="Left" Padding="8,5" Background="Transparent" BorderThickness="0" Click="OpenConversation_Click">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Scope}" FontSize="10" TextTrimming="CharacterEllipsis" Foreground="{StaticResource MutedBrush}" />
                                        </StackPanel>
                                    </Button>
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>
