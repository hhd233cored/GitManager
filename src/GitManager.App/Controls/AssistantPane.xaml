<UserControl x:Class="GitManager.App.Controls.AssistantPane"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Background="#FAFBFC" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,0,0,0">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <StackPanel Margin="12,10,12,0">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Content="设置" Command="{Binding SettingsCommand}" FontSize="10.5" Padding="6,2" Margin="0,0,5,0" />
                        <Button Content="×" Command="{Binding CloseCommand}" Padding="5,0" ToolTip="收起助手" />
                    </StackPanel>
                    <TextBlock Text="Git 助手" FontWeight="SemiBold" FontSize="13" />
                </DockPanel>
                <TextBlock Text="{Binding Scope}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Scope}" FontSize="10.5" Foreground="{StaticResource MutedBrush}" Margin="0,7,0,4" />
                <TextBlock Text="{Binding ConnectionLabel}" FontSize="10" Foreground="#87939F" TextTrimming="CharacterEllipsis" />
                <WrapPanel Margin="0,9,0,7">
                    <Button Content="提交说明" Command="{Binding DraftCommand}" Padding="7,3" FontSize="10.5" Margin="0,0,5,5" />
                    <Button Content="解释提交" Command="{Binding ExplainCommitCommand}" Padding="7,3" FontSize="10.5" Margin="0,0,5,5" />
                    <Button Content="解释 Diff" Command="{Binding ExplainDiffCommand}" Padding="7,3" FontSize="10.5" Margin="0,0,5,5" />
                    <Button Content="同步分析" Command="{Binding AnalyzeSyncCommand}" Padding="7,3" FontSize="10.5" Margin="0,0,5,5" />
                </WrapPanel>
            </StackPanel>
            <ScrollViewer x:Name="ConversationScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="12,0,12,10">
                <StackPanel>
                    <ItemsControl ItemsSource="{Binding Messages}">
                        <ItemsControl.ItemTemplate><DataTemplate>
                            <StackPanel Margin="0,7,0,12">
                                <TextBlock Text="{Binding Label}" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,5" />
                                <TextBox Text="{Binding Text, Mode=OneWay}" IsReadOnly="True" IsTabStop="False" TextWrapping="Wrap" AcceptsReturn="True" BorderThickness="0" Background="Transparent" Padding="0" FontSize="11.5" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Disabled" />
                            </StackPanel>
                        </DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Border x:Name="CommitDraftCard" Background="White" BorderBrush="#C7DDF5" BorderThickness="1" CornerRadius="5" Padding="10" Margin="0,7,0,10" Visibility="{Binding HasDraft, Converter={StaticResource BoolVisibility}}">
                        <StackPanel>
                            <TextBlock Text="提交草稿" FontWeight="SemiBold" Margin="0,0,0,7" />
                            <TextBlock Text="{Binding Draft.Summary}" TextWrapping="Wrap" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding Draft.Description}" TextWrapping="Wrap" FontSize="11" Margin="0,7,0,9" Foreground="{StaticResource MutedBrush}" />
                            <TextBlock Text="{Binding Draft.Warning}" TextWrapping="Wrap" FontSize="10.5" Foreground="#9A6700" Margin="0,0,0,7" Visibility="{Binding Draft.Warning, Converter={StaticResource StringVisibility}}" />
                            <Button Content="填入提交区" Command="{Binding ApplyDraftCommand}" HorizontalAlignment="Left" Style="{StaticResource PrimaryButton}" Padding="10,4" />
                        </StackPanel>
                    </Border>
                    <ItemsControl ItemsSource="{Binding Plans}">
                        <ItemsControl.ItemTemplate><DataTemplate>
                            <Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="5" Padding="10" Margin="0,6,0,5">
                                <StackPanel>
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding Status}" Foreground="{StaticResource BlueBrush}" FontSize="10.5" Margin="0,5,0,4" />
                                    <TextBlock Text="{Binding Detail}" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" FontSize="10.5" MaxHeight="90" TextTrimming="CharacterEllipsis" />
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0" Visibility="{Binding CanReview, Converter={StaticResource BoolVisibility}}">
                                        <Button Content="查看预览…" Click="ReviewPlan_Click" Padding="9,3" Margin="0,0,6,0" />
                                        <Button Content="取消计划" Click="DeclinePlan_Click" Padding="7,3" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
            <StackPanel Grid.Row="2" Margin="12,5,12,10">
                <TextBlock Text="{Binding Error}" TextWrapping="Wrap" Foreground="{StaticResource RedBrush}" FontSize="10.5" MaxHeight="90" Margin="0,0,0,5" />
                <TextBlock Text="{Binding Step}" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,0,0,7" />
                <TextBox x:Name="AssistantInput" Text="{Binding Input, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="58" MaxHeight="120" VerticalScrollBarVisibility="Auto" PreviewKeyDown="Input_KeyDown" ToolTip="描述你的 Git 问题，Ctrl+Enter 发送" />
                <DockPanel Margin="0,8,0,5">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Content="停止" Command="{Binding CancelCommand}" Padding="9,4" Margin="0,0,5,0" Visibility="{Binding IsBusy, Converter={StaticResource BoolVisibility}}" />
                        <Button x:Name="SendAssistantButton" Content="发送" Command="{Binding SendCommand}" Padding="12,4" Style="{StaticResource PrimaryButton}" />
                    </StackPanel>
                    <Button Content="清空对话" Command="{Binding ClearCommand}" Padding="0,3" FontSize="10" Background="Transparent" BorderThickness="0" HorizontalAlignment="Left" />
                </DockPanel>
                <TextBlock Text="{Binding McpStatus}" Foreground="#87939F" FontSize="9.5" TextTrimming="CharacterEllipsis" ToolTip="{Binding McpStatus}" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
