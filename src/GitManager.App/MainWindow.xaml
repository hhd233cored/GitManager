<Window x:Class="GitManager.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:GitManager.App.Controls"
        Title="GitManager" Icon="Assets/AppIcon.ico" Width="1440" Height="900" MinWidth="1080" MinHeight="680" WindowStyle="None"
        WindowStartupLocation="CenterScreen" PreviewKeyDown="Window_PreviewKeyDown" AllowDrop="True" Drop="Window_Drop">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="30" ResizeBorderThickness="6" CornerRadius="0" GlassFrameThickness="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>
    <Grid Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="30" />
            <RowDefinition Height="68" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="29" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#24292F" BorderBrush="#41474E" BorderThickness="0,0,0,1">
            <DockPanel LastChildFill="True" Margin="12,0,0,0">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{StaticResource ToolbarButton}" Width="45" Padding="0" BorderThickness="0" Click="Minimize_Click" ToolTip="最小化" AutomationProperties.Name="最小化窗口">
                        <Path Data="M 0,4 L 10,4" Stroke="#D0D7DE" StrokeThickness="1" Width="10" Height="9" Stretch="None" HorizontalAlignment="Center" />
                    </Button>
                    <Button Style="{StaticResource ToolbarButton}" Width="45" Padding="0" BorderThickness="0" Click="Maximize_Click" ToolTip="最大化 / 还原" AutomationProperties.Name="最大化或还原窗口">
                        <Path Data="M 0,0 L 9,0 L 9,9 L 0,9 Z" Stroke="#D0D7DE" StrokeThickness="1" Width="10" Height="10" Stretch="None" HorizontalAlignment="Center" />
                    </Button>
                    <Button Style="{StaticResource CaptionCloseButton}" Width="45" Padding="0" BorderThickness="0" Click="Exit_Click" ToolTip="关闭" AutomationProperties.Name="关闭窗口">
                        <Path Data="M 0,0 L 10,10 M 0,10 L 10,0" Stroke="#D0D7DE" StrokeThickness="1" Width="11" Height="11" Stretch="None" HorizontalAlignment="Center" />
                    </Button>
                </StackPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" Margin="0,0,20,0">
                    <Border Width="17" Height="17" Background="#3D8BEB" CornerRadius="5" Margin="0,0,8,0">
                        <Path Data="M 5,4 L 5,13 M 5,8 C 5,11 12,5 12,3" Stroke="White" StrokeThickness="1.5" Stretch="None" />
                    </Border>
                    <TextBlock Text="GitManager" Foreground="#F6F8FA" FontWeight="SemiBold" FontSize="11.5" />
                </StackPanel>
                <Menu DockPanel.Dock="Left" Background="Transparent" VerticalAlignment="Center" FontSize="11.5" WindowChrome.IsHitTestVisibleInChrome="True">
                    <MenuItem Header="文件 (_F)" Foreground="#D0D7DE">
                        <MenuItem Header="打开本地仓库…" InputGestureText="Ctrl+O" Click="OpenRepository_Click" />
                        <MenuItem Header="克隆仓库…" Click="CloneRepository_Click" />
                        <Separator />
                        <MenuItem Header="最近的仓库" x:Name="RecentMenu" SubmenuOpened="RecentMenu_Opened" />
                        <Separator />
                        <MenuItem Header="退出" Click="Exit_Click" />
                    </MenuItem>
                    <MenuItem Header="视图 (_V)" Foreground="#D0D7DE">
                        <MenuItem Header="变更 Changes" InputGestureText="Ctrl+1" Click="Changes_Click" />
                        <MenuItem Header="历史 History" InputGestureText="Ctrl+2" Click="History_Click" />
                        <Separator />
                        <MenuItem Header="刷新仓库" InputGestureText="F5" Command="{Binding RefreshCommand}" />
                    </MenuItem>
                    <MenuItem Header="仓库 (_R)" Foreground="#D0D7DE">
                        <MenuItem Header="在资源管理器中打开" Click="RevealRepository_Click" IsEnabled="{Binding HasRepository}" />
                        <Separator />
                        <MenuItem Header="Fetch" Command="{Binding FetchCommand}" />
                        <MenuItem Header="Pull（仅快进）" Command="{Binding PullCommand}" />
                        <MenuItem Header="Push / 发布分支" Command="{Binding PushCommand}" />
                    </MenuItem>
                    <MenuItem Header="分支 (_B)" Foreground="#D0D7DE">
                        <MenuItem Header="新建分支…" Click="NewBranch_Click" IsEnabled="{Binding HasRepository}" />
                    </MenuItem>
                    <MenuItem Header="帮助 (_H)" Foreground="#D0D7DE">
                        <MenuItem Header="快捷键与使用说明" Click="Help_Click" />
                        <MenuItem Header="关于 GitManager" Click="About_Click" />
                    </MenuItem>
                </Menu>
                <Border Background="Transparent" />
            </DockPanel>
        </Border>

        <Border Grid.Row="1" Background="#24292F">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="300" />
                    <ColumnDefinition Width="270" />
                    <ColumnDefinition Width="205" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button Style="{StaticResource ToolbarButton}" Click="RepositorySelector_Click" ToolTip="{Binding RepositoryPath}">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="30" /><ColumnDefinition Width="*" /><ColumnDefinition Width="16" /></Grid.ColumnDefinitions>
                        <Path Grid.Column="0" Data="M 1,1 L 14,1 L 14,17 L 1,17 Z M 4,1 L 4,17 M 6,13 L 11,13" Stroke="#D0D7DE" StrokeThickness="1.3" Width="18" Height="20" Stretch="Uniform" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Current repository" Foreground="#AEB8C4" FontSize="10.5" Margin="0,0,0,4" />
                            <TextBlock Text="{Binding RepositoryName}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <TextBlock Grid.Column="2" Text="⌄" FontSize="16" Foreground="#AEB8C4" />
                    </Grid>
                </Button>
                <Button Grid.Column="1" Style="{StaticResource ToolbarButton}" Click="BranchSelector_Click" IsEnabled="{Binding HasRepository}" ToolTip="切换或创建分支">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="30" /><ColumnDefinition Width="*" /><ColumnDefinition Width="16" /></Grid.ColumnDefinitions>
                        <Path Grid.Column="0" Data="M 4,3 L 4,17 M 4,12 C 4,9 14,12 14,4 M 2,1 L 6,1 L 6,5 L 2,5 Z M 12,1 L 16,1 L 16,5 L 12,5 Z M 2,16 L 6,16 L 6,20 L 2,20 Z" Stroke="#D0D7DE" StrokeThickness="1.3" Width="18" Height="21" Stretch="Uniform" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Current branch" Foreground="#AEB8C4" FontSize="10.5" Margin="0,0,0,4" />
                            <TextBlock Text="{Binding BranchName}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <TextBlock Grid.Column="2" Text="⌄" FontSize="16" Foreground="#AEB8C4" />
                    </Grid>
                </Button>
                <Button Grid.Column="2" Style="{StaticResource ToolbarButton}" Command="{Binding FetchCommand}" ToolTip="获取远程分支和标签，不修改工作区">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="⟳" FontSize="25" Foreground="#D0D7DE" Margin="0,0,13,0" />
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Fetch remote" FontWeight="SemiBold" FontSize="12.5" />
                            <TextBlock Text="{Binding LastFetched}" Foreground="#AEB8C4" FontSize="10.5" Margin="0,4,0,0" />
                        </StackPanel>
                    </StackPanel>
                </Button>
                <TextBlock Grid.Column="3" Text="{Binding SyncStatus}" Foreground="#AEB8C4" Margin="20,0" TextTrimming="CharacterEllipsis" FontSize="11" />
                <StackPanel Grid.Column="4" Orientation="Horizontal" Margin="0,0,12,0" VerticalAlignment="Center">
                    <Button Style="{StaticResource ToolbarButton}" Command="{Binding PullCommand}" Padding="12,9" BorderThickness="0" Content="↓  Pull" ToolTip="拉取远程更新，仅允许快进" />
                    <Button Style="{StaticResource ToolbarButton}" Command="{Binding PushCommand}" Padding="12,9" BorderThickness="0" Margin="4,0,0,0">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="↑  " /><TextBlock Text="{Binding PushLabel}" /></StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="2" Background="#FFF4E5" BorderBrush="#EDC986" BorderThickness="0,0,0,1" Visibility="{Binding HasError, Converter={StaticResource BoolVisibility}}">
            <DockPanel Margin="16,9">
                <Button DockPanel.Dock="Right" Content="关闭" Command="{Binding DismissErrorCommand}" Padding="10,3" Margin="16,0,0,0" />
                <TextBlock DockPanel.Dock="Left" Text="!" Foreground="#9A6700" FontWeight="Bold" FontSize="18" Margin="0,0,12,0" />
                <TextBox Text="{Binding Error, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0" Background="Transparent" Foreground="#7D4E00" MaxHeight="110" VerticalScrollBarVisibility="Auto" Padding="0" />
            </DockPanel>
        </Border>

        <Grid Grid.Row="3" x:Name="RepositoryWorkspace" Visibility="{Binding HasRepository, Converter={StaticResource BoolVisibility}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="HistoryColumn" Width="430" MinWidth="330" />
                <ColumnDefinition Width="1" />
                <ColumnDefinition Width="*" MinWidth="580" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" Background="White">
                <Grid.RowDefinitions><RowDefinition Height="43" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <ToggleButton x:Name="ChangesTab" Style="{StaticResource TabButton}" IsChecked="{Binding IsChanges, Mode=OneWay}" Click="Changes_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Changes" />
                            <Border Background="#E8EDF2" CornerRadius="8" Padding="6,1" Margin="7,0,0,0"><TextBlock Text="{Binding ChangeCount}" FontSize="10.5" Foreground="#576575" /></Border>
                        </StackPanel>
                    </ToggleButton>
                    <ToggleButton x:Name="HistoryTab" Grid.Column="1" Style="{StaticResource TabButton}" IsChecked="{Binding IsHistory, Mode=OneWay}" Click="History_Click" Content="History" />
                </Grid>

                <Grid Grid.Row="1" Visibility="{Binding IsHistory, Converter={StaticResource BoolVisibility}}">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="30" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="12,10">
                        <StackPanel>
                            <Grid>
                                <TextBox x:Name="HistorySearchBox" Text="{Binding HistorySearch, UpdateSourceTrigger=PropertyChanged}" Padding="28,7,10,7" ToolTip="搜索已加载提交的说明、作者、SHA 或分支；Enter 定位下一个匹配项" KeyDown="HistorySearch_KeyDown" />
                                <TextBlock Text="⌕" FontSize="19" Foreground="{StaticResource MutedBrush}" Margin="9,0,0,1" IsHitTestVisible="False" HorizontalAlignment="Left" />
                                <TextBlock Text="搜索提交…" Foreground="#87939F" Margin="30,0,0,0" IsHitTestVisible="False">
                                    <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding HistorySearch}" Value=""><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                </TextBlock>
                            </Grid>
                            <DockPanel Margin="0,10,0,0">
                                <CheckBox Content="所有分支" IsChecked="{Binding AllBranches}" VerticalContentAlignment="Center" IsEnabled="{Binding IsBusy, Converter={StaticResource Not}}" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <TextBlock Text="{Binding SearchMatchCount, StringFormat={}{0} 个匹配}" Foreground="{StaticResource BlueBrush}" Margin="0,0,10,0" Visibility="{Binding HasSearch, Converter={StaticResource BoolVisibility}}" />
                                    <TextBlock Text="{Binding CommitCount, StringFormat={}{0} commits}" Foreground="{StaticResource MutedBrush}" FontSize="11" />
                                </StackPanel>
                            </DockPanel>
                        </StackPanel>
                    </Border>
                    <Border Grid.Row="1" Background="#FAFBFC" BorderBrush="#E8EDF2" BorderThickness="0,0,0,1" Padding="15,0">
                        <DockPanel>
                            <TextBlock Text="提交图 / 提交说明" Foreground="{StaticResource MutedBrush}" FontSize="10.5" />
                            <TextBlock Text="● HEAD" Foreground="{StaticResource BlueBrush}" FontSize="10" HorizontalAlignment="Right" />
                        </DockPanel>
                    </Border>
                    <ListBox x:Name="CommitList" Grid.Row="2" ItemsSource="{Binding Commits}" SelectedItem="{Binding SelectedCommit, Mode=TwoWay}" SelectionChanged="CommitList_SelectionChanged" AutomationProperties.Name="提交历史与分支图" ScrollViewer.HorizontalScrollBarVisibility="Auto">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Height="48" ToolTip="{Binding Subject}">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" MinWidth="120" /></Grid.ColumnDefinitions>
                                    <controls:GraphCell Width="{Binding GraphWidth}" Row="{Binding Graph}" />
                                    <Border Grid.Column="1" BorderBrush="#EEF1F4" BorderThickness="0,0,0,1" Padding="3,0,14,0">
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Subject}" FontSize="12" TextTrimming="CharacterEllipsis" FontWeight="Medium" />
                                            <Border Background="#E9F1FC" CornerRadius="3" Padding="5,1" HorizontalAlignment="Left" Margin="0,4,0,0" MaxWidth="260" Visibility="{Binding HasDecorations, Converter={StaticResource BoolVisibility}}">
                                                <TextBlock Text="{Binding Decorations}" FontSize="10" Foreground="#386AAA" TextTrimming="CharacterEllipsis" />
                                            </Border>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Grid.Row="2" Text="还没有提交记录" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                        <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding CommitCount}" Value="0"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                    </TextBlock>
                    <Border Grid.Row="3" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="12,8" Visibility="{Binding CanLoadMore, Converter={StaticResource BoolVisibility}}">
                        <Button Content="加载更多提交" Command="{Binding LoadMoreCommand}" Padding="10,5" />
                    </Border>
                </Grid>

                <Grid Grid.Row="1" Visibility="{Binding IsChanges, Converter={StaticResource BoolVisibility}}">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <Border Background="{StaticResource PanelBrush}" Padding="12,12" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                        <DockPanel>
                            <TextBlock Text="{Binding ChangeCount, StringFormat={}{0} 个变更文件}" FontWeight="SemiBold" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="全部暂存" Command="{Binding StageAllCommand}" Padding="8,4" Margin="0,0,6,0" />
                                <Button Content="取消暂存" Command="{Binding UnstageAllCommand}" Padding="8,4" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <ListBox x:Name="ChangesList" Grid.Row="1" ItemsSource="{Binding Files}" SelectedItem="{Binding SelectedFile, Mode=TwoWay}" AutomationProperties.Name="工作区变更文件">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Height="34" ToolTip="{Binding DisplayPath}" Margin="12,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="25" /><ColumnDefinition Width="*" /><ColumnDefinition Width="25" /></Grid.ColumnDefinitions>
                                    <CheckBox IsChecked="{Binding StageState, Mode=OneWay}" IsThreeState="True" VerticalAlignment="Center" Click="StageFile_Click" ToolTip="勾选以暂存；半选表示文件同时包含已暂存和未暂存的变更" />
                                    <TextBlock Grid.Column="1" Text="{Binding Path}" TextTrimming="CharacterEllipsis" />
                                    <Border Grid.Column="2" BorderBrush="#D4B663" BorderThickness="1" CornerRadius="2" Width="14" Height="14" HorizontalAlignment="Right">
                                        <TextBlock Text="{Binding Status}" FontSize="9" Foreground="#9A7509" HorizontalAlignment="Center" />
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Grid.Row="1" Text="工作区是干净的" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" IsHitTestVisible="False">
                        <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding ChangeCount}" Value="0"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                    </TextBlock>
                    <Border Grid.Row="2" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Background="#FAFBFC" Padding="14">
                        <StackPanel>
                            <TextBlock Text="创建提交" FontWeight="SemiBold" Margin="0,0,0,10" />
                            <Grid>
                                <TextBox x:Name="CommitSummaryBox" Text="{Binding Summary, UpdateSourceTrigger=PropertyChanged}" Padding="10,8" ToolTip="提交标题（必填）" />
                                <TextBlock Text="Summary（必填）" Margin="11,0" Foreground="#87939F" IsHitTestVisible="False">
                                    <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding Summary}" Value=""><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                </TextBlock>
                            </Grid>
                            <Grid Margin="0,8,0,12">
                                <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" Height="110" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" Padding="10,8" />
                                <TextBlock Text="Description（可选）" Margin="11,9" VerticalAlignment="Top" Foreground="#87939F" IsHitTestVisible="False">
                                    <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding Description}" Value=""><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                </TextBlock>
                            </Grid>
                            <TextBlock Text="{Binding StagedCount, StringFormat={}已暂存 {0} 个文件}" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,0,0,10" />
                            <Button x:Name="CommitButton" Content="{Binding CommitButtonLabel}" Command="{Binding CommitCommand}" Style="{StaticResource PrimaryButton}" Padding="10,9" ToolTip="提交已暂存的变更 · Ctrl+Enter" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>

            <GridSplitter Grid.Column="1" Width="1" HorizontalAlignment="Stretch" ResizeBehavior="PreviousAndNext" ResizeDirection="Columns" />

            <Grid Grid.Column="2" x:Name="DetailsPane">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="22,19,22,15">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,10">
                            <Border DockPanel.Dock="Right" Background="#EDF3FC" CornerRadius="4" Padding="7,3" Margin="12,0,0,0" VerticalAlignment="Top" Visibility="{Binding HasCommit, Converter={StaticResource BoolVisibility}}">
                                <TextBlock Text="COMMIT" Foreground="#5375A4" FontSize="9.5" FontWeight="SemiBold" />
                            </Border>
                            <TextBlock Text="{Binding DetailSubject}" FontSize="19" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Top" />
                        </DockPanel>
                        <TextBox Text="{Binding DetailBody, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0" Background="Transparent" Padding="0" MaxHeight="95" VerticalScrollBarVisibility="Auto" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,12" Visibility="{Binding DetailBody, Converter={StaticResource StringVisibility}}" />
                        <WrapPanel Visibility="{Binding HasCommit, Converter={StaticResource BoolVisibility}}">
                            <Border Width="25" Height="25" CornerRadius="13" Background="#E7EDF7" Margin="0,0,9,0"><TextBlock Text="{Binding DetailInitials}" Foreground="#5474A1" FontWeight="SemiBold" FontSize="10" HorizontalAlignment="Center" /></Border>
                            <TextBlock Text="{Binding DetailAuthor}" FontWeight="SemiBold" ToolTip="{Binding DetailEmail}" Margin="0,0,15,0" />
                            <TextBlock Text="{Binding DetailDate}" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,0,16,0" />
                            <Button x:Name="CopyShaButton" Click="CopySha_Click" Padding="7,3" Background="#F6F8FA" ToolTip="{Binding DetailSha}">
                                <StackPanel Orientation="Horizontal"><TextBlock Text="{Binding DetailShortSha}" FontFamily="Cascadia Mono, Consolas" FontSize="11" /><TextBlock Text="  ⧉" Foreground="{StaticResource MutedBrush}" /></StackPanel>
                            </Button>
                        </WrapPanel>
                        <TextBlock Text="{Binding ParentDescription}" Foreground="#87939F" FontSize="10.5" Margin="34,9,0,0" Visibility="{Binding HasCommit, Converter={StaticResource BoolVisibility}}" />
                    </StackPanel>
                </Border>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="FilesColumn" Width="215" MinWidth="150" />
                        <ColumnDefinition x:Name="FilesSplitterColumn" Width="1" />
                        <ColumnDefinition Width="*" MinWidth="280" />
                    </Grid.ColumnDefinitions>
                    <Grid Visibility="{Binding IsHistory, Converter={StaticResource BoolVisibility}}" x:Name="HistoryFilesPane">
                        <Grid.RowDefinitions><RowDefinition Height="43" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="13,0">
                            <TextBlock Text="{Binding FileCount, StringFormat={}{0} changed files}" Foreground="{StaticResource MutedBrush}" FontSize="11" />
                        </Border>
                        <TextBox Grid.Row="1" Text="{Binding FileSearch, UpdateSourceTrigger=PropertyChanged}" Margin="9,9,9,7" Padding="8,5" ToolTip="过滤变更文件" />
                        <ListBox x:Name="HistoryFilesList" Grid.Row="2" ItemsSource="{Binding Files}" SelectedItem="{Binding SelectedFile, Mode=TwoWay}" AutomationProperties.Name="提交中的变更文件">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Height="34" ToolTip="{Binding DisplayPath}" Margin="12,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="22" /></Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Path}" TextTrimming="CharacterEllipsis" FontSize="11.5" />
                                        <Border Grid.Column="1" BorderBrush="#D4B663" BorderThickness="1" CornerRadius="2" Width="13" Height="13" HorizontalAlignment="Right">
                                            <TextBlock Text="{Binding Status}" FontSize="8.5" Foreground="#9A7509" HorizontalAlignment="Center" />
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock Grid.Row="2" Text="正在读取文件…" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,20,0,0" Visibility="{Binding IsLoadingDetails, Converter={StaticResource BoolVisibility}}" IsHitTestVisible="False" />
                    </Grid>
                    <GridSplitter x:Name="FilesSplitter" Grid.Column="1" Width="1" HorizontalAlignment="Stretch" ResizeBehavior="PreviousAndNext" ResizeDirection="Columns" Visibility="{Binding IsHistory, Converter={StaticResource BoolVisibility}}" />
                    <Grid Grid.Column="2" x:Name="DiffPane">
                        <Grid.RowDefinitions><RowDefinition Height="43" /><RowDefinition Height="30" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="13,0">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="10,0,0,0">
                                    <TextBlock Text="{Binding Additions, StringFormat=+{0}}" Foreground="{StaticResource GreenBrush}" FontFamily="Consolas" FontSize="11" Margin="0,0,10,0" />
                                    <TextBlock Text="{Binding Deletions, StringFormat=−{0}}" Foreground="{StaticResource RedBrush}" FontFamily="Consolas" FontSize="11" />
                                </StackPanel>
                                <TextBlock Text="{Binding FileTitle}" FontFamily="Cascadia Mono, Consolas" FontSize="11" TextTrimming="CharacterEllipsis" ToolTip="{Binding FileTitle}" />
                            </DockPanel>
                        </Border>
                        <Border Grid.Row="1" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Background="#FAFBFC" Padding="10,0">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <Border Background="#EAF0F5" CornerRadius="4" Padding="2" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <ToggleButton x:Name="SplitDiffButton" Style="{StaticResource SegmentButton}" IsChecked="{Binding IsSplitDiff, Mode=OneWay}" Click="SplitDiff_Click" Content="并排" FontSize="10" Padding="9,2" />
                                            <ToggleButton x:Name="UnifiedDiffButton" Style="{StaticResource SegmentButton}" IsChecked="{Binding IsSplitDiff, Converter={StaticResource Not}, Mode=OneWay}" Click="UnifiedDiff_Click" Content="统一" FontSize="10" Padding="9,2" />
                                        </StackPanel>
                                    </Border>
                                    <Button Click="CopyDiff_Click" Content="⧉" Padding="6,1" BorderThickness="0" Background="Transparent" Margin="5,0,0,0" ToolTip="复制完整 Diff" />
                                </StackPanel>
                                <CheckBox DockPanel.Dock="Left" Content="查看已暂存" IsChecked="{Binding ShowStagedDiff}" FontSize="10" VerticalAlignment="Center" Margin="0,0,12,0" Visibility="{Binding CanChooseDiffSource, Converter={StaticResource BoolVisibility}}" />
                                <TextBlock Text="{Binding DiffSourceLabel}" Foreground="#87939F" FontSize="10" />
                            </DockPanel>
                        </Border>
                        <ScrollViewer Grid.Row="2" CanContentScroll="True" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Background="White">
                            <controls:DiffView x:Name="FileDiffView" Document="{Binding Diff}" IsSplit="{Binding IsSplitDiff}" AutomationProperties.Name="文件差异" />
                        </ScrollViewer>
                        <Border Grid.Row="2" Background="#F3FFFFFF" Visibility="{Binding IsLoadingDiff, Converter={StaticResource BoolVisibility}}" IsHitTestVisible="False">
                            <TextBlock Text="正在读取 Diff…" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,30,0,0" />
                        </Border>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>

        <Grid Grid.Row="3" Visibility="{Binding HasRepository, Converter={StaticResource BoolVisibility}}" IsHitTestVisible="False" VerticalAlignment="Top">
            <ProgressBar Height="2" IsIndeterminate="True" Foreground="#3D8BEB" Background="Transparent" BorderThickness="0" Visibility="{Binding IsBusy, Converter={StaticResource BoolVisibility}}" />
        </Grid>

        <Grid Grid.Row="3" Background="#FAFBFC" x:Name="WelcomePane">
            <Grid.Style><Style TargetType="Grid"><Setter Property="Visibility" Value="Visible" /><Style.Triggers><DataTrigger Binding="{Binding HasRepository}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></Grid.Style>
            <StackPanel Width="470" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,-25,0,0">
                <Border Width="68" Height="68" Background="#E9F1FC" CornerRadius="19" HorizontalAlignment="Left" Margin="0,0,0,25">
                    <Path Data="M 8,4 L 8,31 M 8,20 C 8,13 29,23 29,5 M 5,1 L 11,1 L 11,7 L 5,7 Z M 26,1 L 32,1 L 32,7 L 26,7 Z M 5,29 L 11,29 L 11,35 L 5,35 Z" Stroke="#3D8BEB" StrokeThickness="2" Width="35" Height="37" Stretch="Uniform" />
                </Border>
                <TextBlock Text="每一次提交，都清晰可见。" FontSize="29" FontWeight="SemiBold" Margin="0,0,0,12" />
                <TextBlock Text="用分支图探索历史，查看差异，管理你的本地 Git 仓库。" Foreground="{StaticResource MutedBrush}" FontSize="13" TextWrapping="Wrap" LineHeight="23" Margin="0,0,0,26" />
                <StackPanel Orientation="Horizontal">
                    <Button Content="打开本地仓库" Click="OpenRepository_Click" Style="{StaticResource PrimaryButton}" Padding="20,10" Margin="0,0,10,0" />
                    <Button Content="克隆仓库…" Click="CloneRepository_Click" Padding="20,10" />
                </StackPanel>
                <TextBlock Text="也可以把仓库文件夹拖到窗口中  ·  Ctrl+O" Foreground="#87939F" FontSize="11" Margin="0,17,0,0" />
                <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Margin="0,30,0,0" Padding="0,17,0,0">
                    <StackPanel>
                        <TextBlock Text="最近打开" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,0,0,8" />
                        <ItemsControl ItemsSource="{Binding RecentRepositories}">
                            <ItemsControl.ItemTemplate><DataTemplate><Button Content="{Binding}" Click="RecentRepository_Click" HorizontalContentAlignment="Left" BorderThickness="0" Background="Transparent" Padding="0,6" Foreground="{StaticResource BlueBrush}" ToolTip="{Binding}" /></DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <Border Grid.Row="4" Background="#F6F8FA" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="12,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="取消" Command="{Binding CancelCommand}" Padding="7,1" Margin="0,0,10,0" BorderThickness="0" Background="Transparent" FontSize="10.5" Visibility="{Binding IsBusy, Converter={StaticResource BoolVisibility}}" />
                    <TextBlock Text="GitManager" Foreground="#87939F" FontSize="10" />
                </StackPanel>
                <TextBlock Text="{Binding BusyMessage}" Foreground="{StaticResource BlueBrush}" FontSize="10.5" Visibility="{Binding IsBusy, Converter={StaticResource BoolVisibility}}" />
                <TextBlock Text="{Binding Notice}" Foreground="{StaticResource MutedBrush}" FontSize="10.5" TextTrimming="CharacterEllipsis">
                    <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Visible" /><Style.Triggers><DataTrigger Binding="{Binding IsBusy}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                </TextBlock>
            </DockPanel>
        </Border>
    </Grid>
</Window>
